<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hm_background"
    android:orientation="vertical"
    tools:context=".ui.records.RecordsFragment">

    <!-- Header + search (fixed at the top) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/title_records"
            android:textAppearance="@style/TextAppearance.HealthMate.Headline" />

        <TextView
            android:id="@+id/text_records_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.HealthMate.Body"
            tools:text="7 records · Newest first" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/records_search_hint"
            app:endIconContentDescription="@string/records_pick_date"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom"
            app:endIconTint="@color/hm_primary"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789-"
                android:imeOptions="actionSearch"
                android:inputType="date"
                android:maxLength="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- shows the active filter, tap X to clear it (only visible while filtering) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_clear_filter"
            style="@style/Widget.Material3.Chip.Input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checkable="false"
            android:visibility="gone"
            app:chipBackgroundColor="@color/hm_primary_light"
            app:chipStrokeWidth="0dp"
            app:closeIconTint="@color/hm_primary_dark"
            tools:text="Filter: 2026-10"
            tools:visibility="visible" />

        <!-- quick filters -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_quick_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="false"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_all"
                style="@style/Widget.HealthMate.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/records_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_today"
                style="@style/Widget.HealthMate.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/records_filter_today" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_month"
                style="@style/Widget.HealthMate.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/records_filter_month" />
        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_records"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/bottom_content_padding"
            tools:listitem="@layout/item_health_record" />

        <!-- Loading -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_records"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <!-- "No records" message (only shown when the list is empty) -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/image_empty"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_icon_chip"
                android:backgroundTint="@color/hm_primary_light"
                android:importantForAccessibility="no"
                android:padding="18dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/hm_primary" />

            <TextView
                android:id="@+id/text_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/records_empty_title"
                android:textAppearance="@style/TextAppearance.HealthMate.Title" />

            <TextView
                android:id="@+id/text_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/records_empty_message"
                android:textAppearance="@style/TextAppearance.HealthMate.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_empty_action"
                style="@style/Widget.HealthMate.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/records_empty_add"
                app:icon="@drawable/ic_add" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>