<?xml version="1.0" encoding="utf-8"?>
<!-- One small card on the Home screen (steps, calories, water or sleep). Java fills it in. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/metric_icon"
                style="@style/HealthMate.IconChip"
                android:background="@drawable/bg_icon_chip"
                tools:backgroundTint="@color/hm_steps_light"
                tools:src="@drawable/ic_steps"
                tools:tint="@color/hm_steps" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/metric_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:backgroundTint="@color/hm_steps_light"
                tools:text="78%"
                tools:textColor="@color/hm_steps" />
        </LinearLayout>

        <TextView
            android:id="@+id/metric_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.HealthMate.Label"
            tools:text="Steps" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/metric_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.HealthMate.Value"
                tools:text="7,850" />

            <TextView
                android:id="@+id/metric_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.HealthMate.Body"
                android:textSize="13sp"
                tools:text="steps" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/metric_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/metric_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.HealthMate.Body"
            android:textSize="12sp"
            tools:text="78% of 10,000 goal" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>