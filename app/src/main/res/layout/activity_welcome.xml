<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    android:fillViewport="true"
    tools:context=".ui.onboarding.WelcomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <!-- Brand row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_glass"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_welcome_illustration" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/welcome_title"
            android:textColor="@color/white"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/welcome_subtitle"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/welcome_description"
            android:textColor="@color/hm_text_on_dark_muted"
            android:textSize="15sp" />

        <!-- Feature tiles (2 x 2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/HealthMate.WelcomeFeature"
                android:layout_marginEnd="6dp"
                app:drawableStartCompat="@drawable/ic_steps"
                android:text="@string/welcome_feature_steps" />

            <TextView
                style="@style/HealthMate.WelcomeFeature"
                android:layout_marginStart="6dp"
                app:drawableStartCompat="@drawable/ic_water"
                android:text="@string/welcome_feature_water" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/HealthMate.WelcomeFeature"
                android:layout_marginEnd="6dp"
                app:drawableStartCompat="@drawable/ic_sleep"
                android:text="@string/welcome_feature_sleep" />

            <TextView
                style="@style/HealthMate.WelcomeFeature"
                android:layout_marginStart="6dp"
                app:drawableStartCompat="@drawable/ic_progress"
                android:text="@string/welcome_feature_progress" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_get_started"
            style="@style/Widget.HealthMate.Button.White"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_get_started"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/welcome_privacy"
            android:textColor="@color/hm_text_on_dark_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>