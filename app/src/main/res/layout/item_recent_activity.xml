<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the "Recent activity" card on the Home screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/card_padding"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/text_recent_day"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_date_block"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textColor="@color/hm_primary_dark"
        android:textSize="16sp"
        tools:text="17" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_recent_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.HealthMate.Title"
            android:textSize="15sp"
            tools:text="Sat, 17 Oct 2026" />

        <TextView
            android:id="@+id/text_recent_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.HealthMate.Body"
            android:textSize="12sp"
            tools:text="8,420 steps · 430 kcal · 1,900 ml · 7h 30m sleep" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/hm_text_secondary" />
</LinearLayout>