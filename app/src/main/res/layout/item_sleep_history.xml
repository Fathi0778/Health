<?xml version="1.0" encoding="utf-8"?>
<!-- One night in the sleep history list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/card_padding"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/card_padding"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_sleep_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.HealthMate.Title"
            android:textSize="15sp"
            tools:text="Sat, 17 Oct 2026" />

        <TextView
            android:id="@+id/text_sleep_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/hm_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="7h 30m" />

        <TextView
            android:id="@+id/text_sleep_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:backgroundTint="@color/hm_success_light"
            tools:text="Goal met"
            tools:textColor="@color/hm_success" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_sleep_night"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        app:indicatorColor="@color/hm_sleep"
        app:trackColor="@color/hm_sleep_light"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />
</LinearLayout>