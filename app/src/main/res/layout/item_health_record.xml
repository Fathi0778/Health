<?xml version="1.0" encoding="utf-8"?>
<!-- One record card in the Records list -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_record"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Calendar-style date block -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_date_block"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/text_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hm_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="OCT" />

            <TextView
                android:id="@+id/text_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/hm_primary_dark"
                android:textSize="22sp"
                tools:text="18" />

            <TextView
                android:id="@+id/text_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hm_text_secondary"
                android:textSize="11sp"
                tools:text="Sun" />
        </LinearLayout>

        <!-- Values -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_full_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textAppearance="@style/TextAppearance.HealthMate.Title"
                android:textSize="15sp"
                tools:text="Sun, 18 Oct 2026" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_steps"
                    style="@style/HealthMate.RecordStat"
                    app:drawableStartCompat="@drawable/ic_steps_small"
                    app:drawableTint="@color/hm_steps"
                    tools:text="8,420" />

                <TextView
                    android:id="@+id/text_calories"
                    style="@style/HealthMate.RecordStat"
                    app:drawableStartCompat="@drawable/ic_calories_small"
                    app:drawableTint="@color/hm_calories"
                    tools:text="430 kcal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_water"
                    style="@style/HealthMate.RecordStat"
                    app:drawableStartCompat="@drawable/ic_water_small"
                    app:drawableTint="@color/hm_water"
                    tools:text="1,900 ml" />

                <TextView
                    android:id="@+id/text_sleep"
                    style="@style/HealthMate.RecordStat"
                    app:drawableStartCompat="@drawable/ic_sleep_small"
                    app:drawableTint="@color/hm_sleep"
                    tools:text="7h 30m" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/hm_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_delete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/hm_error" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>