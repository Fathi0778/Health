<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hm_background"
    android:orientation="vertical"
    tools:context=".ui.sleep.SleepFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/hm_background"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/hm_text_primary"
        app:title="@string/title_sleep"
        app:titleTextAppearance="@style/TextAppearance.HealthMate.Title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <!-- ===== Tonight / today hero ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_sleep"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_glass"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_sleep"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/text_sleep_recorded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/white"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="Sleep recorded: 7h 30m" />

                    <TextView
                        android:id="@+id/text_sleep_status_today"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/hm_sleep_light"
                        android:textSize="13sp"
                        tools:text="30m below your goal" />

                    <TextView
                        android:id="@+id/text_sleep_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_glass"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Goal: 8 hours" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="12dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_sleep_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:max="100"
                        app:indicatorColor="@color/white"
                        app:indicatorSize="96dp"
                        app:trackColor="@color/hm_white_20"
                        app:trackCornerRadius="5dp"
                        app:trackThickness="9dp" />

                    <TextView
                        android:id="@+id/text_sleep_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        tools:text="94%" />
                </FrameLayout>
            </LinearLayout>

            <!-- ===== Weekly stats ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tile_weekly_average"
                    layout="@layout/item_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tile_nights_goal"
                    layout="@layout/item_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tile_best_night"
                    layout="@layout/item_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- ===== Weekly chart ===== -->
            <include
                android:id="@+id/chart_sleep_week"
                layout="@layout/item_chart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/grid_gap" />

            <!-- ===== History ===== -->
            <TextView
                style="@style/HealthMate.SectionTitle"
                android:text="@string/sleep_history" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/container_sleep_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/text_sleep_history_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/sleep_history_empty"
                        android:textAppearance="@style/TextAppearance.HealthMate.Body"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_log_sleep"
                style="@style/Widget.HealthMate.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/sleep_log"
                app:backgroundTint="@color/hm_sleep"
                app:icon="@drawable/ic_add" />

            <!-- Note: the app does not give medical advice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawablePadding="10dp"
                android:text="@string/sleep_disclaimer"
                android:textAppearance="@style/TextAppearance.HealthMate.Body"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/hm_text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>